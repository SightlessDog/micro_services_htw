# ── Secrets ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# ── Database passwords ────────────────────────────────────────────────────────
POSTGRES_USER_PASS=change-me
POSTGRES_PRODUCT_PASS=change-me
POSTGRES_ORDER_PASS=change-me
POSTGRES_ZITADEL_PASS=change-me

# ── Zitadel (identity provider) ───────────────────────────────────────────────
# 32-byte random string, e.g. `openssl rand -base64 32`
ZITADEL_MASTERKEY=change-me-32-bytes-exactly!!
# Client ID of the SPA application created in the Zitadel console (see README
# "Zitadel setup" section) — public client, no secret.
ZITADEL_CLIENT_ID=change-me
# Org ID that owns the SPA client above — pins login/registration to that org.
ZITADEL_ORG_ID=change-me
# Hostname/port Zitadel issues tokens with as `iss` (ZITADEL_EXTERNALDOMAIN /
# ZITADEL_EXTERNALPORT). The gateway must send this exact Host header on
# internal /oidc and /oauth calls, or Zitadel rejects the token.
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8081
