server {
    listen 80;
    server_name localhost;

    # Pass real client IP downstream
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Strip upstream's own copies of these (Spring Security / helmet etc. set
    # their own) so add_header below doesn't end up duplicating them.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Content-Security-Policy;

    # Baseline security headers for every response.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    # Throttle proxied API + identity endpoints; allow short bursts.
    limit_req zone=gateway_limit burst=40 nodelay;

    # Cloud Run hostnames resolve to many IPs; nginx's default retry-next-IP
    # behavior on a single failed attempt can fan one client request into a
    # rapid internal retry storm. One attempt only — fail fast instead.
    proxy_next_upstream off;

    # Service URLs injected by envsubst at container start.
    # Local dev: http://user-service:8000   Cloud Run: https://...-xxx.run.app
    # proxy_ssl_server_name is a no-op for plain HTTP, required for HTTPS (Cloud Run).
    location /users {
        proxy_pass ${USER_SERVICE_URL};
        proxy_ssl_server_name on;
    }

    location /products {
        proxy_pass ${PRODUCT_SERVICE_URL};
        proxy_ssl_server_name on;
    }

    location /orders {
        proxy_pass ${ORDER_SERVICE_URL};
        proxy_ssl_server_name on;
    }

    # JWKS + userinfo proxy — backends always hit gateway so Host header is correct.
    # ZITADEL_PROXY_URL: local = http://zitadel:8080, Cloud Run = https://tenant.zitadel.cloud
    # ZITADEL_HOST_HEADER: local = localhost:8081 (self-hosted Zitadel requires it),
    #                       Cloud Run = tenant.zitadel.cloud
    location /oauth/v2/keys {
        proxy_pass ${ZITADEL_PROXY_URL}/oauth/v2/keys;
        proxy_set_header Host ${ZITADEL_HOST_HEADER};
        proxy_ssl_server_name on;
    }

    location /oidc/v1/userinfo {
        proxy_pass ${ZITADEL_PROXY_URL}/oidc/v1/userinfo;
        proxy_set_header Host ${ZITADEL_HOST_HEADER};
        proxy_ssl_server_name on;
    }

    location /health {
        return 200 '{"status":"gateway-ok"}';
        add_header Content-Type application/json;
    }
}
